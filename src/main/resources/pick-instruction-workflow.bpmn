<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://camunda.org/examples"
             id="Definitions_pickInstructionWorkflow">

  <!-- ═══════════════════════════════════════════════════
       Message definitions for intermediate catch events
       ═══════════════════════════════════════════════════ -->
  <message id="Message_ValidationResult" name="PickListResponseMessage"/>
  <message id="Message_TransactionUpdate" name="TransactionUpdateMessage"/>

  <!-- ═══════════════════════════════════════════════════
       Main Process
       ═══════════════════════════════════════════════════ -->
  <process id="pickInstructionProcess" name="Pick Instruction Workflow" isExecutable="true" camunda:historyTimeToLive="P30D">

    <!-- ─── Start Event ─── -->
    <startEvent id="startEvent" name="Start">
      <outgoing>flow_start_to_publishOrder</outgoing>
    </startEvent>

    <!-- ─── Publish Order to Kafka ─── -->
    <serviceTask id="publishOrderTask"
                 name="Publish Order to Kafka"
                 camunda:delegateExpression="${publishOrderToKafkaDelegate}">
      <incoming>flow_start_to_publishOrder</incoming>
      <outgoing>flow_publishOrder_to_waitValidation</outgoing>
    </serviceTask>

    <!-- ─── Wait for Validation Result (Message Catch) ─── -->
    <intermediateCatchEvent id="waitForValidation" name="Wait for Validation">
      <incoming>flow_publishOrder_to_waitValidation</incoming>
      <outgoing>flow_waitValidation_to_publishResponse</outgoing>
      <messageEventDefinition id="MsgDef_validation" messageRef="Message_ValidationResult"/>
    </intermediateCatchEvent>

    <!-- ─── Publish pick-instruction.response to butler_server ─── -->
    <serviceTask id="publishPickInstructionResponseTask"
                 name="Publish pick-instruction.response"
                 camunda:delegateExpression="${publishPickInstructionResponseDelegate}">
      <incoming>flow_waitValidation_to_publishResponse</incoming>
      <outgoing>flow_publishResponse_to_validationGw</outgoing>
    </serviceTask>

    <!-- ─── Validation Gateway ─── -->
    <exclusiveGateway id="validationGateway" name="Validation OK?" default="flow_validationGw_to_checkComplete">
      <incoming>flow_publishResponse_to_validationGw</incoming>
      <outgoing>flow_validationGw_failed</outgoing>
      <outgoing>flow_validationGw_to_checkComplete</outgoing>
    </exclusiveGateway>

    <!-- ─── [FAIL PATH] Terminate AE order in PostgreSQL ─── -->
    <serviceTask id="terminateAeOrderTask"
                 name="Terminate AE Order"
                 camunda:delegateExpression="${terminateAeOrderDelegate}">
      <incoming>flow_validationGw_failed</incoming>
      <outgoing>flow_terminateAeOrder_to_end</outgoing>
    </serviceTask>

    <endEvent id="endValidationFailed" name="End (Validation Failed)">
      <incoming>flow_terminateAeOrder_to_end</incoming>
    </endEvent>

    <!-- ─── Check if Pick Instruction Already Complete ─── -->
    <serviceTask id="checkCompleteTask"
                 name="Check PI Complete?"
                 camunda:delegateExpression="${checkPickInstructionCompleteDelegate}">
      <incoming>flow_validationGw_to_checkComplete</incoming>
      <outgoing>flow_checkComplete_to_alreadyCompleteGw</outgoing>
    </serviceTask>

    <!-- ─── Already Complete Gateway ─── -->
    <exclusiveGateway id="isAlreadyCompleteGateway" name="Already Complete?" default="flow_alreadyCompleteGw_to_waitTx">
      <incoming>flow_checkComplete_to_alreadyCompleteGw</incoming>
      <outgoing>flow_alreadyCompleteGw_yes</outgoing>
      <outgoing>flow_alreadyCompleteGw_to_waitTx</outgoing>
    </exclusiveGateway>

    <!-- ─── [EARLY COMPLETE PATH] Mark complete early ─── -->
    <serviceTask id="markCompleteEarly"
                 name="Mark PI Complete (Early)"
                 camunda:delegateExpression="${markPickInstructionCompleteDelegate}">
      <incoming>flow_alreadyCompleteGw_yes</incoming>
      <outgoing>flow_markCompleteEarly_to_onComplete</outgoing>
    </serviceTask>

    <serviceTask id="onWorkflowCompleteEarly"
                 name="On Workflow Complete (Early)"
                 camunda:delegateExpression="${onWorkflowCompleteDelegate}">
      <incoming>flow_markCompleteEarly_to_onComplete</incoming>
      <outgoing>flow_onCompleteEarly_to_end</outgoing>
    </serviceTask>

    <endEvent id="endAlreadyComplete" name="End (Already Complete)">
      <incoming>flow_onCompleteEarly_to_end</incoming>
    </endEvent>

    <!-- ─── Wait for Transaction Update (Message Catch — loops back here) ─── -->
    <intermediateCatchEvent id="waitForTransactionUpdate" name="Wait for Transaction Update">
      <incoming>flow_alreadyCompleteGw_to_waitTx</incoming>
      <incoming>flow_republishRetry_to_waitTx</incoming>
      <incoming>flow_updateInProgress_to_waitTx</incoming>
      <incoming>flow_republishRetriable_to_waitTx</incoming>
      <outgoing>flow_waitTx_to_sendTxKafka</outgoing>
      <messageEventDefinition id="MsgDef_txUpdate" messageRef="Message_TransactionUpdate"/>
    </intermediateCatchEvent>

    <!-- ─── Send Transaction Kafka Event ─── -->
    <serviceTask id="sendTransactionKafkaTask"
                 name="Send Transaction Kafka Event"
                 camunda:delegateExpression="${sendTransactionKafkaEventDelegate}">
      <incoming>flow_waitTx_to_sendTxKafka</incoming>
      <outgoing>flow_sendTxKafka_to_commandGw</outgoing>
    </serviceTask>

    <!-- ─── Command Gateway ─── -->
    <exclusiveGateway id="commandGateway" name="Command?" default="flow_commandGw_update">
      <incoming>flow_sendTxKafka_to_commandGw</incoming>
      <outgoing>flow_commandGw_cancel</outgoing>
      <outgoing>flow_commandGw_complete</outgoing>
      <outgoing>flow_commandGw_retry</outgoing>
      <outgoing>flow_commandGw_update</outgoing>
    </exclusiveGateway>

    <!-- ─── [CANCEL PATH] ─── -->
    <serviceTask id="markFailedCancel"
                 name="Mark Failed (Cancel)"
                 camunda:delegateExpression="${markPickInstructionFailedDelegate}">
      <incoming>flow_commandGw_cancel</incoming>
      <outgoing>flow_markFailedCancel_to_onComplete</outgoing>
    </serviceTask>

    <serviceTask id="onWorkflowCompleteCancel"
                 name="On Workflow Complete (Cancel)"
                 camunda:delegateExpression="${onWorkflowCompleteDelegate}">
      <incoming>flow_markFailedCancel_to_onComplete</incoming>
      <outgoing>flow_onCompleteCancel_to_end</outgoing>
    </serviceTask>

    <endEvent id="endCancel" name="End (Cancelled)">
      <incoming>flow_onCompleteCancel_to_end</incoming>
    </endEvent>

    <!-- ─── [COMPLETE COMMAND PATH] ─── -->
    <serviceTask id="markCompleteCmd"
                 name="Mark PI Complete (Command)"
                 camunda:delegateExpression="${markPickInstructionCompleteDelegate}">
      <incoming>flow_commandGw_complete</incoming>
      <outgoing>flow_markCompleteCmd_to_onComplete</outgoing>
    </serviceTask>

    <serviceTask id="onWorkflowCompleteComplete"
                 name="On Workflow Complete (Complete)"
                 camunda:delegateExpression="${onWorkflowCompleteDelegate}">
      <incoming>flow_markCompleteCmd_to_onComplete</incoming>
      <outgoing>flow_onCompleteComplete_to_end</outgoing>
    </serviceTask>

    <endEvent id="endComplete" name="End (Completed via Command)">
      <incoming>flow_onCompleteComplete_to_end</incoming>
    </endEvent>

    <!-- ─── [RETRY PATH] Republish to Kafka and loop back ─── -->
    <serviceTask id="republishRetry"
                 name="Republish Order (Retry)"
                 camunda:delegateExpression="${publishOrderToKafkaDelegate}">
      <incoming>flow_commandGw_retry</incoming>
      <outgoing>flow_republishRetry_to_waitTx</outgoing>
    </serviceTask>

    <!-- ─── [UPDATE PATH] TX Failed Gateway ─── -->
    <exclusiveGateway id="txFailedGateway" name="TX Status FAILED?" default="flow_txFailedGw_notFailed">
      <incoming>flow_commandGw_update</incoming>
      <outgoing>flow_txFailedGw_failed</outgoing>
      <outgoing>flow_txFailedGw_notFailed</outgoing>
    </exclusiveGateway>

    <!-- ─── [TX FAILED PATH] ─── -->
    <serviceTask id="markFailedTx"
                 name="Mark Failed (TX Failed)"
                 camunda:delegateExpression="${markPickInstructionFailedDelegate}">
      <incoming>flow_txFailedGw_failed</incoming>
      <outgoing>flow_markFailedTx_to_onComplete</outgoing>
    </serviceTask>

    <serviceTask id="onWorkflowCompleteTxFailed"
                 name="On Workflow Complete (TX Failed)"
                 camunda:delegateExpression="${onWorkflowCompleteDelegate}">
      <incoming>flow_markFailedTx_to_onComplete</incoming>
      <outgoing>flow_onCompleteTxFailed_to_end</outgoing>
    </serviceTask>

    <endEvent id="endTxFailed" name="End (TX Failed)">
      <incoming>flow_onCompleteTxFailed_to_end</incoming>
    </endEvent>

    <!-- ─── Update Pick Instruction ─── -->
    <serviceTask id="updatePickInstructionTask"
                 name="Update Pick Instruction"
                 camunda:delegateExpression="${updatePickInstructionDelegate}">
      <incoming>flow_txFailedGw_notFailed</incoming>
      <outgoing>flow_updatePI_to_updateResultGw</outgoing>
    </serviceTask>

    <!-- ─── Update Result Gateway ─── -->
    <exclusiveGateway id="updateResultGateway" name="Update Result?" default="flow_updateResultGw_successInProgress">
      <incoming>flow_updatePI_to_updateResultGw</incoming>
      <outgoing>flow_updateResultGw_successComplete</outgoing>
      <outgoing>flow_updateResultGw_successInProgress</outgoing>
      <outgoing>flow_updateResultGw_retriable</outgoing>
      <outgoing>flow_updateResultGw_nonRetriable</outgoing>
    </exclusiveGateway>

    <!-- ─── [SUCCESS + COMPLETE PATH] ─── -->
    <serviceTask id="markCompleteUpdate"
                 name="Mark PI Complete (Update)"
                 camunda:delegateExpression="${markPickInstructionCompleteDelegate}">
      <incoming>flow_updateResultGw_successComplete</incoming>
      <outgoing>flow_markCompleteUpdate_to_onComplete</outgoing>
    </serviceTask>

    <serviceTask id="onWorkflowCompleteUpdate"
                 name="On Workflow Complete (Update Complete)"
                 camunda:delegateExpression="${onWorkflowCompleteDelegate}">
      <incoming>flow_markCompleteUpdate_to_onComplete</incoming>
      <outgoing>flow_onCompleteUpdate_to_end</outgoing>
    </serviceTask>

    <endEvent id="endUpdateComplete" name="End (Update Complete)">
      <incoming>flow_onCompleteUpdate_to_end</incoming>
    </endEvent>

    <!-- ─── [RETRIABLE ERROR PATH] Republish and loop back ─── -->
    <serviceTask id="republishRetriable"
                 name="Republish Order (Retriable Error)"
                 camunda:delegateExpression="${publishOrderToKafkaDelegate}">
      <incoming>flow_updateResultGw_retriable</incoming>
      <outgoing>flow_republishRetriable_to_waitTx</outgoing>
    </serviceTask>

    <!-- ─── [NON-RETRIABLE ERROR PATH] ─── -->
    <serviceTask id="markFailedNR"
                 name="Mark Failed (Non-Retriable)"
                 camunda:delegateExpression="${markPickInstructionFailedDelegate}">
      <incoming>flow_updateResultGw_nonRetriable</incoming>
      <outgoing>flow_markFailedNR_to_butlerCore</outgoing>
    </serviceTask>

    <serviceTask id="markFailureButlerCore"
                 name="Mark Failure in Butler Core"
                 camunda:delegateExpression="${markFailureInButlerCoreDelegate}">
      <incoming>flow_markFailedNR_to_butlerCore</incoming>
      <outgoing>flow_butlerCore_to_onComplete</outgoing>
    </serviceTask>

    <serviceTask id="onWorkflowCompleteNR"
                 name="On Workflow Complete (Non-Retriable)"
                 camunda:delegateExpression="${onWorkflowCompleteDelegate}">
      <incoming>flow_butlerCore_to_onComplete</incoming>
      <outgoing>flow_onCompleteNR_to_end</outgoing>
    </serviceTask>

    <endEvent id="endNonRetriable" name="End (Non-Retriable Error)">
      <incoming>flow_onCompleteNR_to_end</incoming>
    </endEvent>

    <!-- ════════════════════════════════════════════
         SEQUENCE FLOWS
         ════════════════════════════════════════════ -->

    <!-- Start → Publish Order -->
    <sequenceFlow id="flow_start_to_publishOrder"
                  sourceRef="startEvent"
                  targetRef="publishOrderTask"/>

    <!-- Publish Order → Wait for Validation -->
    <sequenceFlow id="flow_publishOrder_to_waitValidation"
                  sourceRef="publishOrderTask"
                  targetRef="waitForValidation"/>

    <!-- Wait for Validation → Publish pick-instruction.response -->
    <sequenceFlow id="flow_waitValidation_to_publishResponse"
                  sourceRef="waitForValidation"
                  targetRef="publishPickInstructionResponseTask"/>

    <!-- Publish pick-instruction.response → Validation Gateway -->
    <sequenceFlow id="flow_publishResponse_to_validationGw"
                  sourceRef="publishPickInstructionResponseTask"
                  targetRef="validationGateway"/>

    <!-- Validation Gateway → FAILED (validationSuccess == false) -->
    <sequenceFlow id="flow_validationGw_failed"
                  sourceRef="validationGateway"
                  targetRef="terminateAeOrderTask">
      <conditionExpression xsi:type="tFormalExpression">${validationSuccess == false}</conditionExpression>
    </sequenceFlow>

    <!-- Validation Gateway → Check Complete (default: validationSuccess == true) -->
    <sequenceFlow id="flow_validationGw_to_checkComplete"
                  sourceRef="validationGateway"
                  targetRef="checkCompleteTask"/>

    <!-- Terminate AE Order → End (Validation Failed) -->
    <sequenceFlow id="flow_terminateAeOrder_to_end"
                  sourceRef="terminateAeOrderTask"
                  targetRef="endValidationFailed"/>

    <!-- Check Complete → Already Complete Gateway -->
    <sequenceFlow id="flow_checkComplete_to_alreadyCompleteGw"
                  sourceRef="checkCompleteTask"
                  targetRef="isAlreadyCompleteGateway"/>

    <!-- Already Complete Gateway → Mark Complete Early (isAlreadyComplete == true) -->
    <sequenceFlow id="flow_alreadyCompleteGw_yes"
                  sourceRef="isAlreadyCompleteGateway"
                  targetRef="markCompleteEarly">
      <conditionExpression xsi:type="tFormalExpression">${isAlreadyComplete == true}</conditionExpression>
    </sequenceFlow>

    <!-- Already Complete Gateway → Wait for TX Update (default: isAlreadyComplete == false) -->
    <sequenceFlow id="flow_alreadyCompleteGw_to_waitTx"
                  sourceRef="isAlreadyCompleteGateway"
                  targetRef="waitForTransactionUpdate"/>

    <!-- Mark Complete Early → On Workflow Complete (Early) -->
    <sequenceFlow id="flow_markCompleteEarly_to_onComplete"
                  sourceRef="markCompleteEarly"
                  targetRef="onWorkflowCompleteEarly"/>

    <!-- On Workflow Complete (Early) → End -->
    <sequenceFlow id="flow_onCompleteEarly_to_end"
                  sourceRef="onWorkflowCompleteEarly"
                  targetRef="endAlreadyComplete"/>

    <!-- Wait for TX Update → Send Transaction Kafka Event -->
    <sequenceFlow id="flow_waitTx_to_sendTxKafka"
                  sourceRef="waitForTransactionUpdate"
                  targetRef="sendTransactionKafkaTask"/>

    <!-- Send Transaction Kafka Event → Command Gateway -->
    <sequenceFlow id="flow_sendTxKafka_to_commandGw"
                  sourceRef="sendTransactionKafkaTask"
                  targetRef="commandGateway"/>

    <!-- Command Gateway → Cancel path -->
    <sequenceFlow id="flow_commandGw_cancel"
                  sourceRef="commandGateway"
                  targetRef="markFailedCancel">
      <conditionExpression xsi:type="tFormalExpression">${command == 'CANCEL'}</conditionExpression>
    </sequenceFlow>

    <!-- Command Gateway → Complete command path -->
    <sequenceFlow id="flow_commandGw_complete"
                  sourceRef="commandGateway"
                  targetRef="markCompleteCmd">
      <conditionExpression xsi:type="tFormalExpression">${command == 'COMPLETE'}</conditionExpression>
    </sequenceFlow>

    <!-- Command Gateway → Retry path -->
    <sequenceFlow id="flow_commandGw_retry"
                  sourceRef="commandGateway"
                  targetRef="republishRetry">
      <conditionExpression xsi:type="tFormalExpression">${command == 'RETRY'}</conditionExpression>
    </sequenceFlow>

    <!-- Command Gateway → Update path (default) -->
    <sequenceFlow id="flow_commandGw_update"
                  sourceRef="commandGateway"
                  targetRef="txFailedGateway"/>

    <!-- Mark Failed (Cancel) → On Workflow Complete (Cancel) -->
    <sequenceFlow id="flow_markFailedCancel_to_onComplete"
                  sourceRef="markFailedCancel"
                  targetRef="onWorkflowCompleteCancel"/>

    <!-- On Workflow Complete (Cancel) → End -->
    <sequenceFlow id="flow_onCompleteCancel_to_end"
                  sourceRef="onWorkflowCompleteCancel"
                  targetRef="endCancel"/>

    <!-- Mark Complete (Command) → On Workflow Complete (Complete) -->
    <sequenceFlow id="flow_markCompleteCmd_to_onComplete"
                  sourceRef="markCompleteCmd"
                  targetRef="onWorkflowCompleteComplete"/>

    <!-- On Workflow Complete (Complete) → End -->
    <sequenceFlow id="flow_onCompleteComplete_to_end"
                  sourceRef="onWorkflowCompleteComplete"
                  targetRef="endComplete"/>

    <!-- Republish (Retry) → loop back to Wait for TX Update -->
    <sequenceFlow id="flow_republishRetry_to_waitTx"
                  sourceRef="republishRetry"
                  targetRef="waitForTransactionUpdate"/>

    <!-- TX Failed Gateway → TX FAILED path (txStatus == FAILED) -->
    <sequenceFlow id="flow_txFailedGw_failed"
                  sourceRef="txFailedGateway"
                  targetRef="markFailedTx">
      <conditionExpression xsi:type="tFormalExpression">${txStatus == 'FAILED'}</conditionExpression>
    </sequenceFlow>

    <!-- TX Failed Gateway → Update PI (default: txStatus != FAILED) -->
    <sequenceFlow id="flow_txFailedGw_notFailed"
                  sourceRef="txFailedGateway"
                  targetRef="updatePickInstructionTask"/>

    <!-- Mark Failed (TX Failed) → On Workflow Complete (TX Failed) -->
    <sequenceFlow id="flow_markFailedTx_to_onComplete"
                  sourceRef="markFailedTx"
                  targetRef="onWorkflowCompleteTxFailed"/>

    <!-- On Workflow Complete (TX Failed) → End -->
    <sequenceFlow id="flow_onCompleteTxFailed_to_end"
                  sourceRef="onWorkflowCompleteTxFailed"
                  targetRef="endTxFailed"/>

    <!-- Update PI → Update Result Gateway -->
    <sequenceFlow id="flow_updatePI_to_updateResultGw"
                  sourceRef="updatePickInstructionTask"
                  targetRef="updateResultGateway"/>

    <!-- Update Result Gateway → Success + Complete (updateSuccess && txComplete) -->
    <sequenceFlow id="flow_updateResultGw_successComplete"
                  sourceRef="updateResultGateway"
                  targetRef="markCompleteUpdate">
      <conditionExpression xsi:type="tFormalExpression">${updateSuccess == true and txComplete == true}</conditionExpression>
    </sequenceFlow>

    <!-- Update Result Gateway → Success + In-Progress (default: updateSuccess && !txComplete) — loop back -->
    <sequenceFlow id="flow_updateResultGw_successInProgress"
                  sourceRef="updateResultGateway"
                  targetRef="waitForTransactionUpdate"/>

    <!-- Update Result Gateway → Retriable error (!updateSuccess && updateRetriable) -->
    <sequenceFlow id="flow_updateResultGw_retriable"
                  sourceRef="updateResultGateway"
                  targetRef="republishRetriable">
      <conditionExpression xsi:type="tFormalExpression">${updateSuccess == false and updateRetriable == true}</conditionExpression>
    </sequenceFlow>

    <!-- Update Result Gateway → Non-retriable error (!updateSuccess && !updateRetriable) -->
    <sequenceFlow id="flow_updateResultGw_nonRetriable"
                  sourceRef="updateResultGateway"
                  targetRef="markFailedNR">
      <conditionExpression xsi:type="tFormalExpression">${updateSuccess == false and updateRetriable == false}</conditionExpression>
    </sequenceFlow>

    <!-- Mark Complete (Update) → On Workflow Complete (Update Complete) -->
    <sequenceFlow id="flow_markCompleteUpdate_to_onComplete"
                  sourceRef="markCompleteUpdate"
                  targetRef="onWorkflowCompleteUpdate"/>

    <!-- On Workflow Complete (Update Complete) → End -->
    <sequenceFlow id="flow_onCompleteUpdate_to_end"
                  sourceRef="onWorkflowCompleteUpdate"
                  targetRef="endUpdateComplete"/>

    <!-- Republish (Retriable) → loop back to Wait for TX Update -->
    <sequenceFlow id="flow_republishRetriable_to_waitTx"
                  sourceRef="republishRetriable"
                  targetRef="waitForTransactionUpdate"/>

    <!-- Mark Failed (NR) → Mark Failure in Butler Core -->
    <sequenceFlow id="flow_markFailedNR_to_butlerCore"
                  sourceRef="markFailedNR"
                  targetRef="markFailureButlerCore"/>

    <!-- Mark Failure in Butler Core → On Workflow Complete (NR) -->
    <sequenceFlow id="flow_butlerCore_to_onComplete"
                  sourceRef="markFailureButlerCore"
                  targetRef="onWorkflowCompleteNR"/>

    <!-- On Workflow Complete (NR) → End -->
    <sequenceFlow id="flow_onCompleteNR_to_end"
                  sourceRef="onWorkflowCompleteNR"
                  targetRef="endNonRetriable"/>

    <!-- ════════════════════════════════════════════
         LOOP-BACK: update in-progress → wait for next TX
         (default path of updateResultGateway already points there)
         ════════════════════════════════════════════ -->
    <!-- flow_updateResultGw_successInProgress already targets waitForTransactionUpdate -->

  </process>

  <!-- ═══════════════════════════════════════════════════
       BPMN Diagram Interchange (minimal layout)
       ═══════════════════════════════════════════════════ -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="pickInstructionProcess">

      <bpmndi:BPMNShape id="startEvent_di" bpmnElement="startEvent">
        <dc:Bounds x="152" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="publishOrderTask_di" bpmnElement="publishOrderTask">
        <dc:Bounds x="240" y="60" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="waitForValidation_di" bpmnElement="waitForValidation">
        <dc:Bounds x="412" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="publishPickInstructionResponseTask_di" bpmnElement="publishPickInstructionResponseTask">
        <dc:Bounds x="460" y="60" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="validationGateway_di" bpmnElement="validationGateway" isMarkerVisible="true">
        <dc:Bounds x="635" y="75" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="terminateAeOrderTask_di" bpmnElement="terminateAeOrderTask">
        <dc:Bounds x="600" y="160" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="endValidationFailed_di" bpmnElement="endValidationFailed">
        <dc:Bounds x="772" y="182" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="checkCompleteTask_di" bpmnElement="checkCompleteTask">
        <dc:Bounds x="600" y="60" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="isAlreadyCompleteGateway_di" bpmnElement="isAlreadyCompleteGateway" isMarkerVisible="true">
        <dc:Bounds x="775" y="75" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="markCompleteEarly_di" bpmnElement="markCompleteEarly">
        <dc:Bounds x="880" y="60" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="onWorkflowCompleteEarly_di" bpmnElement="onWorkflowCompleteEarly">
        <dc:Bounds x="1040" y="60" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="endAlreadyComplete_di" bpmnElement="endAlreadyComplete">
        <dc:Bounds x="1212" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="waitForTransactionUpdate_di" bpmnElement="waitForTransactionUpdate">
        <dc:Bounds x="800" y="282" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="sendTransactionKafkaTask_di" bpmnElement="sendTransactionKafkaTask">
        <dc:Bounds x="880" y="260" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="commandGateway_di" bpmnElement="commandGateway" isMarkerVisible="true">
        <dc:Bounds x="1055" y="275" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="markFailedCancel_di" bpmnElement="markFailedCancel">
        <dc:Bounds x="1160" y="160" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="onWorkflowCompleteCancel_di" bpmnElement="onWorkflowCompleteCancel">
        <dc:Bounds x="1320" y="160" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="endCancel_di" bpmnElement="endCancel">
        <dc:Bounds x="1492" y="182" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="markCompleteCmd_di" bpmnElement="markCompleteCmd">
        <dc:Bounds x="1160" y="60" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="onWorkflowCompleteComplete_di" bpmnElement="onWorkflowCompleteComplete">
        <dc:Bounds x="1320" y="60" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="endComplete_di" bpmnElement="endComplete">
        <dc:Bounds x="1492" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="republishRetry_di" bpmnElement="republishRetry">
        <dc:Bounds x="1160" y="360" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="txFailedGateway_di" bpmnElement="txFailedGateway" isMarkerVisible="true">
        <dc:Bounds x="1055" y="435" width="50" height="50"/>
      </bpmndi:BPMNShape>

